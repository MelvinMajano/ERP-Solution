# Conexión a Base de Datos (Slim 4 / Eloquent)
DB_DRIVER=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=saas_erp_db
DB_USERNAME=saas_erp_user
DB_PASSWORD=your_database_password_here

# Configuración Runtime de la API
API_BASE_PATH=/api/v1
API_PROD=false
API_CORS=*
LOGS_ROOT_PATH=/logs

# Autenticación y Firma de Tokens JWT
JWT_SECRET=generate_a_random_64_character_hex_string
JWT_EXPIRES_IN=86400